# Copy this file to .env.local
#
# Local development with the Firebase Emulator Suite (no real Firebase project needed):
# keep VITE_USE_EMULATORS=true and the demo-brewdesk project ID below.
VITE_USE_EMULATORS=true
VITE_SHOW_DEMO_LOGIN=true

# For a real Firebase project, paste the values from
# Firebase console > Project settings > Your apps > Web app, and set VITE_USE_EMULATORS=false.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-brewdesk.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-brewdesk
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=demo-app-id

# --- Server only (Vercel environment variables; NOT prefixed with VITE_) ---
# Not needed with the emulators. For a real project, from
# Firebase console > Project settings > Service accounts > Generate new private key.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
